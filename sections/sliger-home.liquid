{% liquid
  assign minimalist_link = section.settings.minimalist_link
  if minimalist_link == blank
    assign minimalist_link = 'https://amzn.to/4oeNoVx'
  endif

  assign cerave_link = section.settings.cerave_link
  if cerave_link == blank
    assign cerave_link = 'https://amzn.to/4vbHQOp'
  endif

  assign simple_link = section.settings.simple_link
  if simple_link == blank
    assign simple_link = 'https://amzn.to/4dWvPog'
  endif

  assign ordinary_link = section.settings.ordinary_link
  if ordinary_link == blank
    assign ordinary_link = 'https://amzn.to/4e0LAL6'
  endif
%}

<div class="sliger-page sliger-shop-page">
  <section class="sliger-shop-hero">
    <div class="sliger-shell sliger-shop-hero__grid">
      <div class="sliger-shop-hero__copy">
        <p class="sliger-shop-kicker">Curated face wash edit</p>
        <h1>Find your everyday face wash.</h1>
        <p>
          A clean, curated cleanser shop for brightening, foaming, fresh, and sensitive-skin routines.
          Compare four focused picks and buy the right one through Amazon.
        </p>
        <div class="sliger-shop-hero__actions">
          <a class="sliger-button" href="#shop">Shop Now</a>
          <a class="sliger-button-secondary" href="#compare">Compare Picks</a>
        </div>
        <div class="sliger-shop-proof" aria-label="SLIGER shopping benefits">
          <span>4 curated cleansers</span>
          <span>Direct Amazon checkout</span>
          <span>No cart confusion</span>
        </div>
      </div>

      <div class="sliger-shop-hero__media" aria-label="Featured cleanser products">
        <div class="sliger-shop-leaf" aria-hidden="true"></div>
        <div class="sliger-shop-hero__badge-card">
          <span>4 picks</span>
          <strong>Brighten, balance, foam, refresh</strong>
        </div>
        <img class="sliger-shop-hero__product sliger-shop-hero__product--one sliger-shop-hero__product--cutout" src="{{ 'sliger-simple-facewash-cutout.png' | asset_url }}" alt="Simple Refreshing Facial Wash" width="408" height="612" loading="eager">
        <img class="sliger-shop-hero__product sliger-shop-hero__product--two sliger-shop-hero__product--cutout" src="{{ 'sliger-ordinary-glucoside-cutout.png' | asset_url }}" alt="The Ordinary Glucoside Foaming Cleanser" width="447" height="559" loading="eager">
        <img class="sliger-shop-hero__product sliger-shop-hero__product--three sliger-shop-hero__product--cutout" src="{{ 'sliger-minimalist-cleanser-cutout.png' | asset_url }}" alt="Minimalist Alpha Lipoic and Glycolic Cleanser" width="426" height="586" loading="eager">
        <img class="sliger-shop-hero__product sliger-shop-hero__product--four" src="{{ 'sliger-cerave-cleanser.jpg' | asset_url }}" alt="CeraVe Foaming Facial Cleanser" width="736" height="1096" loading="eager">
      </div>
    </div>

    <div class="sliger-shop-dots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>
  </section>

  <section id="shop" class="sliger-shop-section">
    <div class="sliger-shell">
      <div class="sliger-shop-heading">
        <p class="sliger-shop-kicker">Our featured products</p>
        <h2>Four cleansers, sorted by skin goal.</h2>
        <p>Skip the crowded catalog. Choose by routine need, scan the product fit, and open the right Amazon page.</p>
      </div>

      <div class="sliger-shop-finder" aria-label="Find a cleanser by skin moment">
        <article>
          <span>Brighten</span>
          <strong>Dull or uneven skin feel</strong>
          <a href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">Choose Minimalist</a>
        </article>
        <article>
          <span>Balance</span>
          <strong>Normal to oily daily wash</strong>
          <a href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">Choose CeraVe</a>
        </article>
        <article>
          <span>Fresh</span>
          <strong>Light morning cleanse</strong>
          <a href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">Choose Simple</a>
        </article>
        <article>
          <span>Gentle foam</span>
          <strong>Soft foaming reset</strong>
          <a href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">Choose The Ordinary</a>
        </article>
      </div>

      <div class="sliger-product-toolbar sliger-shop-toolbar" data-sliger-filter-group>
        <button class="sliger-filter is-active" type="button" data-sliger-filter="all" aria-pressed="true">All</button>
        <button class="sliger-filter" type="button" data-sliger-filter="fresh" aria-pressed="false">Fresh</button>
        <button class="sliger-filter" type="button" data-sliger-filter="foaming" aria-pressed="false">Foaming</button>
        <button class="sliger-filter" type="button" data-sliger-filter="brightening" aria-pressed="false">Brightening</button>
        <button class="sliger-filter" type="button" data-sliger-filter="sensitive" aria-pressed="false">Sensitive</button>
      </div>

      <div class="sliger-shop-products">
        <article class="sliger-shop-product" data-sliger-product="brightening daily">
          <a class="sliger-shop-product__image sliger-shop-product__image--cutout sliger-shop-product__image--warm" href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <img src="{{ 'sliger-minimalist-cleanser-cutout.png' | asset_url }}" alt="Minimalist Alpha Lipoic and Glycolic Cleanser" width="426" height="586" loading="lazy">
            <span>-7%</span>
          </a>
          <div class="sliger-shop-product__body">
            <p>Brightening pick</p>
            <h3>Minimalist Alpha Lipoic + Glycolic Cleanser</h3>
            <small>For a smoother-looking, brighter-feeling cleanse.</small>
            <a href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Now</a>
          </div>
        </article>

        <article class="sliger-shop-product" data-sliger-product="foaming sensitive daily">
          <a class="sliger-shop-product__image" href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <img src="{{ 'sliger-cerave-cleanser.jpg' | asset_url }}" alt="CeraVe Foaming Facial Cleanser" width="736" height="1096" loading="lazy">
          </a>
          <div class="sliger-shop-product__body">
            <p>Oil-control pick</p>
            <h3>CeraVe Foaming Facial Cleanser</h3>
            <small>For normal to oily skin and a repeatable daily wash.</small>
            <a href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Now</a>
          </div>
        </article>

        <article class="sliger-shop-product" data-sliger-product="fresh sensitive daily">
          <a class="sliger-shop-product__image sliger-shop-product__image--cutout sliger-shop-product__image--green" href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <img src="{{ 'sliger-simple-facewash-cutout.png' | asset_url }}" alt="Simple Refreshing Facial Wash" width="408" height="612" loading="lazy">
            <span>Fresh</span>
          </a>
          <div class="sliger-shop-product__body">
            <p>Fresh daily pick</p>
            <h3>Simple Refreshing Facial Wash</h3>
            <small>For a light, clean-feeling start without heavy fragrance.</small>
            <a href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Now</a>
          </div>
        </article>

        <article class="sliger-shop-product" data-sliger-product="foaming sensitive daily">
          <a class="sliger-shop-product__image sliger-shop-product__image--cutout" href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <img src="{{ 'sliger-ordinary-glucoside-cutout.png' | asset_url }}" alt="The Ordinary Glucoside Foaming Cleanser" width="447" height="559" loading="lazy">
          </a>
          <div class="sliger-shop-product__body">
            <p>Gentle foam pick</p>
            <h3>The Ordinary Glucoside Foaming Cleanser</h3>
            <small>For a soft foaming cleanse across everyday skin types.</small>
            <a href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Now</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sliger-shop-section sliger-shop-promo-section">
    <div class="sliger-shell sliger-shop-promos">
      <article class="sliger-shop-promo">
        <div>
          <p class="sliger-shop-kicker">Fresh routine</p>
          <h2>Start clean without overthinking your shelf.</h2>
          <p>Pick Simple when you want an easy daily refresh, or choose The Ordinary when a gentle foam feels right.</p>
          <a class="sliger-button-secondary" href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">Explore Simple</a>
        </div>
        <img class="sliger-shop-promo__cutout sliger-shop-promo__cutout--simple" src="{{ 'sliger-simple-facewash-cutout.png' | asset_url }}" alt="Simple Refreshing Facial Wash" width="408" height="612" loading="lazy">
      </article>

      <article class="sliger-shop-promo sliger-shop-promo--green">
        <div>
          <p class="sliger-shop-kicker">Cleanser guide</p>
          <h2>One page. Four clear cleanser decisions.</h2>
          <p>Brighten with Minimalist, balance with CeraVe, refresh with Simple, or foam gently with The Ordinary.</p>
          <a class="sliger-button-secondary" href="#compare">Compare All</a>
        </div>
        <img class="sliger-shop-promo__cutout" src="{{ 'sliger-ordinary-glucoside-cutout.png' | asset_url }}" alt="The Ordinary Glucoside Foaming Cleanser" width="447" height="559" loading="lazy">
      </article>
    </div>
  </section>

  <section id="compare" class="sliger-shop-section sliger-shop-section--soft">
    <div class="sliger-shell">
      <div class="sliger-shop-heading">
        <p class="sliger-shop-kicker">Compare by routine goal</p>
        <h2>Choose the cleanser that matches the moment.</h2>
        <p>Each product has a clear job, so the buying decision stays simple.</p>
      </div>

      <div class="sliger-shop-compare">
        <div>
          <strong>Brightening routine</strong>
          <span>Minimalist Alpha Lipoic + Glycolic Cleanser</span>
          <a href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Minimalist</a>
        </div>
        <div>
          <strong>Normal to oily skin</strong>
          <span>CeraVe Foaming Facial Cleanser</span>
          <a href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy CeraVe</a>
        </div>
        <div>
          <strong>Fresh daily cleanse</strong>
          <span>Simple Refreshing Facial Wash</span>
          <a href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy Simple</a>
        </div>
        <div>
          <strong>Gentle foaming cleanse</strong>
          <span>The Ordinary Glucoside Foaming Cleanser</span>
          <a href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy The Ordinary</a>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="sliger-shop-section">
    <div class="sliger-shell sliger-shop-faq-grid">
      <div>
        <p class="sliger-shop-kicker">Before you buy</p>
        <h2>Clear answers before checkout.</h2>
        <p>SLIGER helps you compare products. Amazon handles current price, delivery, payment, returns, and order support.</p>
      </div>

      <div class="sliger-faq-list">
        <details class="sliger-card sliger-faq">
          <summary>Can users buy from this website?<span>+</span></summary>
          <p>Users choose a product here, click Buy Now, and complete the final purchase on Amazon through your affiliate link.</p>
        </details>
        <details class="sliger-card sliger-faq">
          <summary>Are all four products active?<span>+</span></summary>
          <p>Yes. Minimalist, CeraVe, Simple, and The Ordinary all have active Buy Now links.</p>
        </details>
        <details class="sliger-card sliger-faq">
          <summary>Is this medical advice?<span>+</span></summary>
          <p>No. This page is for shopping guidance only. For skin conditions or irritation, consult a qualified dermatologist.</p>
        </details>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SLIGER home",
  "settings": [
    {
      "type": "url",
      "id": "minimalist_link",
      "label": "Minimalist buy link"
    },
    {
      "type": "url",
      "id": "cerave_link",
      "label": "CeraVe buy link"
    },
    {
      "type": "url",
      "id": "simple_link",
      "label": "Simple buy link"
    },
    {
      "type": "url",
      "id": "ordinary_link",
      "label": "The Ordinary buy link"
    }
  ],
  "presets": [
    {
      "name": "SLIGER home"
    }
  ]
}
{% endschema %}
