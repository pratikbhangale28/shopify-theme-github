      "label": "The Face Shop Rice Water buy link"
    },
    {
      "type": "url",
      "id": "sebamed_link",
      "label": "Sebamed buy link"
    },
    {
      "type": "url",
      "id": "dotkey_link",
      "label": "DOT & KEY buy link"
    },
    {
      "type": "url",
      "id": "neutrogena_link",
      "label": "Neutrogena buy link"
    }
  ],
  "presets": [
    {
      "name": "SLIGER home"
    }
  ]
}
{% endschema %}
