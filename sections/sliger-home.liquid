{% liquid
  assign minimalist_link = section.settings.minimalist_link
  if minimalist_link == blank
    assign minimalist_link = 'https://amzn.to/4emVBT1'
  endif

  assign derma_link = section.settings.derma_link
  if derma_link == blank
    assign derma_link = 'https://amzn.to/43DcjIS'
  endif

  assign cerave_link = section.settings.cerave_link
  if cerave_link == blank
    assign cerave_link = 'https://amzn.to/4vSRHZn'
  endif

  assign cetaphil_link = section.settings.cetaphil_link
  if cetaphil_link == blank
    assign cetaphil_link = 'https://amzn.to/4xHEh46'
  endif

  assign face_shop_link = section.settings.face_shop_link
  if face_shop_link == blank
    assign face_shop_link = 'https://amzn.to/43y4gx6'
  endif

  assign sebamed_link = section.settings.sebamed_link
  if sebamed_link == blank
    assign sebamed_link = 'https://amzn.to/4arsgFO'
  endif

  assign dotkey_link = section.settings.dotkey_link
  if dotkey_link == blank
    assign dotkey_link = 'https://amzn.to/4e9QAyg'
  endif

  assign neutrogena_link = section.settings.neutrogena_link
  if neutrogena_link == blank
    assign neutrogena_link = 'https://amzn.to/3S5TZ8U'
  endif
%}

<div class="sliger-page sliger-shop-page sliger-premium-home">
  <section class="sliger-premium-hero" aria-labelledby="sliger-hero-title">
    <div class="sliger-premium-hero__scene" aria-hidden="true">
      <span class="sliger-hero-prop sliger-hero-prop--dish"></span>
      <span class="sliger-hero-prop sliger-hero-prop--leaf"></span>
      <span class="sliger-hero-prop sliger-hero-prop--foam"></span>
      <span class="sliger-hero-prop sliger-hero-prop--drop"></span>
    </div>

    <div class="sliger-shell sliger-premium-hero__content">
      <p class="sliger-premium-kicker">Premium cleanser edit</p>
      <h1 id="sliger-hero-title">Discover the face wash your skin needs.</h1>
      <p>A refined edit of eight cleansers for hydration, glow, barrier care, oil control, and gentle daily routines.</p>
      <div class="sliger-premium-actions">
        <a class="sliger-premium-button" href="#shop">Shop cleansers <span aria-hidden="true">&rarr;</span></a>
        <a class="sliger-premium-button sliger-premium-button--light" href="#compare">Compare picks <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section id="shop" class="sliger-premium-section sliger-premium-products" aria-labelledby="sliger-products-title">
    <div class="sliger-shell">
      <div class="sliger-premium-heading">
        <p class="sliger-premium-kicker">Choose by face-wash category</p>
        <h2 id="sliger-products-title">Shop the complete cleanser edit</h2>
        <div class="sliger-premium-tabs sliger-premium-category-grid" data-sliger-filter-group aria-label="Choose a face wash category">
          <button class="is-active" type="button" data-sliger-filter="all" aria-pressed="true">
            <strong>All face washes</strong>
            <span>Browse the full edit</span>
          </button>
          <button type="button" data-sliger-filter="daily" aria-pressed="false">
            <strong>Daily gentle</strong>
            <span>Comfortable everyday cleansing</span>
          </button>
          <button type="button" data-sliger-filter="hydrating" aria-pressed="false">
            <strong>Hydrating</strong>
            <span>Dry skin and barrier support</span>
          </button>
          <button type="button" data-sliger-filter="brightening" aria-pressed="false">
            <strong>Brightening</strong>
            <span>Freshness, glow, and clarity</span>
          </button>
          <button type="button" data-sliger-filter="sensitive" aria-pressed="false">
            <strong>Sensitive skin</strong>
            <span>Calm, gentle-feeling formulas</span>
          </button>
          <button type="button" data-sliger-filter="oil" aria-pressed="false">
            <strong>Oil control</strong>
            <span>Oily and combination skin</span>
          </button>
        </div>
      </div>

      <div class="sliger-premium-product-row">
        <article class="sliger-premium-card" data-sliger-product="brightening oil">
          <a class="sliger-premium-card__image sliger-premium-card__image--pale" href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>brighten</span>
            <img src="{{ 'sliger-product-minimalist.webp' | asset_url }}" alt="Minimalist Alpha Lipoic and Glycolic Cleanser" width="300" height="300" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Minimalist Alpha Lipoic + Glycolic Cleanser</h3>
              <p>For a brighter-looking cleanse and smoother-feeling skin.</p>
              <div class="sliger-premium-card__details">
                <span>Brightening</span>
                <span>Texture care</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="sensitive hydrating">
          <a class="sliger-premium-card__image sliger-premium-card__image--blue" href="{{ derma_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>gentle</span>
            <img src="{{ 'sliger-product-dermaco.jpg' | asset_url }}" alt="The Derma Co 2% Niacinamide Oily Skin Cleanser" width="1080" height="1080" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>The Derma Co 2% Niacinamide Gentle Skin Cleanser</h3>
              <p>For a gentle niacinamide cleanse with a soft finish.</p>
              <div class="sliger-premium-card__details">
                <span>Niacinamide</span>
                <span>Sensitive</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ derma_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="hydrating sensitive">
          <a class="sliger-premium-card__image sliger-premium-card__image--green" href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>hydrate</span>
            <img src="{{ 'sliger-product-cerave-hydrating.jpg' | asset_url }}" alt="CeraVe Hydrating Cleanser" width="1500" height="1500" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>CeraVe Hydrating Cleanser</h3>
              <p>For hydration-focused cleansing and barrier support.</p>
              <div class="sliger-premium-card__details">
                <span>Hydrating</span>
                <span>Barrier care</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="daily hydrating sensitive bestseller">
          <a class="sliger-premium-card__image sliger-premium-card__image--fresh" href="{{ cetaphil_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>best seller</span>
            <img src="{{ 'sliger-product-cetaphil-gentle.jpg' | asset_url }}" alt="Cetaphil Gentle Skin Cleanser" width="1500" height="1500" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Cetaphil Gentle Skin Cleanser</h3>
              <p>Best-seller for a classic gentle daily cleanse.</p>
              <div class="sliger-premium-card__details">
                <span>Best seller</span>
                <span>Daily gentle</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ cetaphil_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="brightening hydrating">
          <a class="sliger-premium-card__image sliger-premium-card__image--rose" href="{{ face_shop_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>rice water</span>
            <img src="{{ 'sliger-product-face-shop-rice.jpg' | asset_url }}" alt="The Face Shop Rice Water Bright Foaming Cleanser" width="1000" height="1000" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>The Face Shop Rice Water Bright Foaming Cleanser</h3>
              <p>For a creamy foam and a fresh, luminous feel.</p>
              <div class="sliger-premium-card__details">
                <span>Rice water</span>
                <span>Foaming</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ face_shop_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="sensitive oil">
          <a class="sliger-premium-card__image sliger-premium-card__image--clean" href="{{ sebamed_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>pH 5.5</span>
            <img src="{{ 'sliger-product-sebamed.jpg' | asset_url }}" alt="Sebamed Gentle Facial Cleanser" width="1083" height="1500" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Sebamed Gentle Facial Cleanser</h3>
              <p>For a pH-balanced cleanse with a light finish.</p>
              <div class="sliger-premium-card__details">
                <span>pH 5.5</span>
                <span>Oil control</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ sebamed_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="hydrating sensitive">
          <a class="sliger-premium-card__image sliger-premium-card__image--aqua" href="{{ dotkey_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>barrier</span>
            <img src="{{ 'sliger-product-dot-key.jpg' | asset_url }}" alt="DOT &amp; KEY Barrier Repair Hydrating Gentle Face Wash" width="1500" height="1500" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>DOT &amp; KEY Barrier Repair + Hydrating Gentle Face Wash</h3>
              <p>For barrier care, hydration, and soft daily cleansing.</p>
              <div class="sliger-premium-card__details">
                <span>Barrier repair</span>
                <span>Hydrating</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ dotkey_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="oil">
          <a class="sliger-premium-card__image sliger-premium-card__image--amber" href="{{ neutrogena_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>deep clean</span>
            <img src="{{ 'sliger-product-neutrogena.jpg' | asset_url }}" alt="Neutrogena Deep Clean Gentle Facial Cleanser" width="1001" height="1001" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Neutrogena Deep Clean Gentle Facial Cleanser</h3>
              <p>For a deeper clean and fresh-feeling oily skin routines.</p>
              <div class="sliger-premium-card__details">
                <span>Deep clean</span>
                <span>Oily skin</span>
              </div>
            </div>
            <a class="sliger-premium-buy" href="{{ neutrogena_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now <span aria-hidden="true">&rarr;</span></a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sliger-premium-benefits" aria-label="Product benefits">
    <div class="sliger-premium-benefits__track">
      <span>Dermatologist-loved formulas</span>
      <span>Hydrating options</span>
      <span>Gentle daily cleansing</span>
      <span>Best-seller picks</span>
      <span>Brightening routines</span>
      <span>Direct product checkout</span>
      <span>Barrier support</span>
    </div>
  </section>

  <section class="sliger-premium-section sliger-premium-story">
    <div class="sliger-shell sliger-premium-story__grid">
      <div class="sliger-premium-story__image sliger-premium-story__image--collage">
        <img src="{{ 'sliger-simple-oily.jpg' | asset_url }}" alt="Fresh face wash lifestyle flat lay" width="736" height="736" loading="lazy">
      </div>
      <div class="sliger-premium-story__copy">
        <p class="sliger-premium-kicker">Curated for simpler routines</p>
        <h2>Skincare shopping without the crowded shelf.</h2>
        <p>Every product in this edit has a clear role, so shoppers can compare by skin goal, choose with confidence, and go straight to the product page.</p>
        <a class="sliger-premium-button sliger-premium-button--light" href="#shop">Shop the lineup <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section id="compare" class="sliger-premium-section sliger-premium-how" aria-labelledby="sliger-how-title">
    <div class="sliger-shell sliger-premium-how__grid">
      <div>
        <p class="sliger-premium-kicker">How to choose</p>
        <h2 id="sliger-how-title">
          <span>start with skin goal</span>
          <span>match the texture</span>
          <span>shop the right cleanser</span>
        </h2>
        <div class="sliger-premium-steps">
          <div><strong>1</strong><span>Choose your category.</span></div>
          <div><strong>2</strong><span>Compare the cleanser feel.</span></div>
          <div><strong>3</strong><span>Open the product page.</span></div>
        </div>
        <a class="sliger-premium-button sliger-premium-button--light" href="#shop">View products <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="sliger-premium-how__image">
        <img src="{{ 'sliger-cetaphil-editorial.jpg' | asset_url }}" alt="Cleanser editorial product image" width="736" height="1104" loading="lazy">
      </div>
    </div>
  </section>
</div>

