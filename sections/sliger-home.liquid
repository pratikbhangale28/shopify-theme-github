{% liquid
  assign minimalist_link = section.settings.minimalist_link
  if minimalist_link == blank
    assign minimalist_link = 'https://amzn.to/4oeNoVx'
  endif

  assign cerave_link = section.settings.cerave_link
  if cerave_link == blank
    assign cerave_link = 'https://amzn.to/4vbHQOp'
  endif

  assign simple_link = section.settings.simple_link
  if simple_link == blank
    assign simple_link = 'https://amzn.to/4dWvPog'
  endif

  assign ordinary_link = section.settings.ordinary_link
  if ordinary_link == blank
    assign ordinary_link = 'https://amzn.to/4e0LAL6'
  endif
%}

<div class="sliger-page sliger-shop-page sliger-premium-home">
  <section class="sliger-premium-hero" aria-labelledby="sliger-hero-title">
    <div class="sliger-premium-hero__scene" aria-hidden="true">
      <span class="sliger-hero-prop sliger-hero-prop--dish"></span>
      <span class="sliger-hero-prop sliger-hero-prop--leaf"></span>
      <span class="sliger-hero-prop sliger-hero-prop--foam"></span>
      <span class="sliger-hero-prop sliger-hero-prop--drop"></span>
      <img class="sliger-hero-product sliger-hero-product--simple" src="{{ 'sliger-simple-facewash-cutout.png' | asset_url }}" alt="" width="408" height="612" loading="eager">
      <img class="sliger-hero-product sliger-hero-product--ordinary" src="{{ 'sliger-ordinary-glucoside-cutout.png' | asset_url }}" alt="" width="447" height="559" loading="eager">
      <img class="sliger-hero-product sliger-hero-product--minimalist" src="{{ 'sliger-minimalist-cleanser-cutout.png' | asset_url }}" alt="" width="426" height="586" loading="eager">
      <img class="sliger-hero-product sliger-hero-product--cetaphil" src="{{ 'sliger-cetaphil-cutout.png' | asset_url }}" alt="" width="552" height="828" loading="eager">
    </div>

    <div class="sliger-shell sliger-premium-hero__content">
      <p class="sliger-premium-kicker">Curated cleanser edit</p>
      <h1 id="sliger-hero-title">Say hello to your new favorite daily cleanse.</h1>
      <p>Premium skincare picks for fresh mornings, gentle resets, and clean-feeling skin without a crowded routine.</p>
      <div class="sliger-premium-actions">
        <a class="sliger-premium-button" href="#shop">Shop cleansers <span aria-hidden="true">&rarr;</span></a>
        <a class="sliger-premium-button sliger-premium-button--light" href="#compare">Compare picks <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section class="sliger-premium-proof" aria-labelledby="sliger-proof-title">
    <div class="sliger-shell sliger-premium-proof__grid">
      <div class="sliger-premium-quote">
        <h2 id="sliger-proof-title">"Products like these make everyday cleansing feel considered, simple, and premium."</h2>
        <div class="sliger-premium-press" aria-label="Featured editorial labels">
          <span>BRIT+CO</span>
          <span>Editorial Pick</span>
          <span>Skin Guide</span>
          <span>Clean Routine</span>
        </div>
      </div>

      <a class="sliger-premium-review" href="#shop">
        <strong>Over 1,600 Shopper Notes</strong>
        <span aria-label="Five stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <small>read the reviews</small>
      </a>
    </div>
  </section>

  <section class="sliger-premium-benefits" aria-label="Product benefits">
    <div class="sliger-premium-benefits__track">
      <span>Dermatologist-loved formulas</span>
      <span>Gentle daily options</span>
      <span>Fresh-feeling cleanse</span>
      <span>Oily-skin friendly</span>
      <span>No routine confusion</span>
    </div>
  </section>

  <section id="shop" class="sliger-premium-section sliger-premium-products" aria-labelledby="sliger-products-title">
    <div class="sliger-shell">
      <div class="sliger-premium-heading">
        <h2 id="sliger-products-title">Our science-backed cleanser picks</h2>
        <div class="sliger-premium-tabs" data-sliger-filter-group aria-label="Filter products">
          <button class="is-active" type="button" data-sliger-filter="all" aria-pressed="true">all</button>
          <button type="button" data-sliger-filter="fresh" aria-pressed="false">fresh</button>
          <button type="button" data-sliger-filter="brightening" aria-pressed="false">brighten</button>
          <button type="button" data-sliger-filter="sensitive" aria-pressed="false">sensitive</button>
        </div>
      </div>

      <div class="sliger-premium-product-row">
        <article class="sliger-premium-product-intro">
          <h3>Curated formulas to cleanse, refresh, and keep your shelf simple.</h3>
          <a class="sliger-premium-button sliger-premium-button--light" href="#compare">Find your pick <span aria-hidden="true">&rarr;</span></a>
        </article>

        <article class="sliger-premium-card" data-sliger-product="fresh sensitive">
          <a class="sliger-premium-card__image" href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>daily</span>
            <img src="{{ 'sliger-simple-facewash-cutout.png' | asset_url }}" alt="Simple Refreshing Facial Wash" width="408" height="612" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Simple Refreshing Facial Wash</h3>
              <p>Kind-to-skin daily refresh</p>
            </div>
            <a href="{{ simple_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now</a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="brightening">
          <a class="sliger-premium-card__image sliger-premium-card__image--pale" href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>brighten</span>
            <img src="{{ 'sliger-minimalist-cleanser-cutout.png' | asset_url }}" alt="Minimalist Alpha Lipoic and Glycolic Cleanser" width="426" height="586" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Minimalist Alpha Lipoic + Glycolic Cleanser</h3>
              <p>Smoother-looking skin feel</p>
            </div>
            <a href="{{ minimalist_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now</a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="sensitive foaming">
          <a class="sliger-premium-card__image sliger-premium-card__image--blue" href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>oily skin</span>
            <img src="{{ 'sliger-cetaphil-cutout.png' | asset_url }}" alt="Cetaphil Oily Skin Cleanser" width="552" height="828" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>Cetaphil Oily Skin Cleanser</h3>
              <p>Balanced daily cleansing</p>
            </div>
            <a href="{{ cerave_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now</a>
          </div>
        </article>

        <article class="sliger-premium-card" data-sliger-product="fresh sensitive foaming">
          <a class="sliger-premium-card__image sliger-premium-card__image--clean" href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">
            <span>foam</span>
            <img src="{{ 'sliger-ordinary-glucoside-cutout.png' | asset_url }}" alt="The Ordinary Glucoside Foaming Cleanser" width="447" height="559" loading="lazy">
          </a>
          <div class="sliger-premium-card__body">
            <div>
              <h3>The Ordinary Glucoside Foaming Cleanser</h3>
              <p>Soft foaming reset</p>
            </div>
            <a href="{{ ordinary_link }}" target="_blank" rel="sponsored noopener noreferrer">Buy now</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="sliger-premium-section sliger-premium-story">
    <div class="sliger-shell sliger-premium-story__grid">
      <div class="sliger-premium-story__image">
        <img src="{{ 'sliger-cetaphil-water.jpg' | asset_url }}" alt="Cleanser bottle with water splash" width="736" height="1104" loading="lazy">
      </div>
      <div class="sliger-premium-story__copy">
        <p class="sliger-premium-kicker">More about us</p>
        <h2>Clean routines, edited for everyday shoppers.</h2>
        <p>SLIGER keeps the decision simple: a short list of focused skincare products, clear use cases, and direct checkout through trusted product pages.</p>
        <a class="sliger-premium-button sliger-premium-button--light" href="/pages/about">Get the full story <span aria-hidden="true">&rarr;</span></a>
      </div>
    </div>
  </section>

  <section id="compare" class="sliger-premium-section sliger-premium-how" aria-labelledby="sliger-how-title">
    <div class="sliger-shell sliger-premium-how__grid">
      <div>
        <p class="sliger-premium-kicker">How our picks work</p>
        <h2 id="sliger-how-title">
          <span>morning cleanse</span>
          <span>oil balance</span>
          <span>gentle foam</span>
        </h2>
        <div class="sliger-premium-steps">
          <div><strong>1</strong><span>Choose your skin goal.</span></div>
          <div><strong>2</strong><span>Open the product page.</span></div>
          <div><strong>3</strong><span>Checkout on Amazon.</span></div>
        </div>
        <a class="sliger-premium-button sliger-premium-button--light" href="#shop">Learn more <span aria-hidden="true">&rarr;</span></a>
      </div>
      <div class="sliger-premium-how__image">
        <img src="{{ 'sliger-cetaphil-editorial.jpg' | asset_url }}" alt="Cetaphil cleanser editorial product image" width="736" height="1104" loading="lazy">
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "SLIGER home",
  "settings": [
    {
      "type": "url",
      "id": "minimalist_link",
      "label": "Minimalist buy link"
    },
    {
      "type": "url",
      "id": "cerave_link",
      "label": "Cetaphil/CeraVe buy link"
    },
    {
      "type": "url",
      "id": "simple_link",
      "label": "Simple buy link"
    },
    {
      "type": "url",
      "id": "ordinary_link",
      "label": "The Ordinary buy link"
    }
  ],
  "presets": [
    {
      "name": "SLIGER home"
    }
  ]
}
{% endschema %}
