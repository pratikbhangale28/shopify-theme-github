{% liquid
  assign buy_link = section.settings.buy_link
  if buy_link == blank
    assign buy_link = 'https://amzn.to/4oeNoVx'
  endif
%}

<header class="sliger-header" data-sliger-header data-sliger-menu="closed">
  <div class="sliger-header__top">
    <div class="sliger-shell sliger-header__top-inner">
      <span>Free shipping on select U.S. orders!</span>
      <a href="{{ routes.root_url }}#shop">Shop Now</a>
      <span>Meet your new favorite daily cleanse</span>
      <a href="{{ routes.root_url }}#shop">Shop Now</a>
    </div>
  </div>

  <div class="sliger-shell sliger-header__inner sliger-header__inner--brand-only">
    <a class="sliger-brand" href="{{ routes.root_url }}" aria-label="SLIGER home">
      <span class="sliger-brand__mark">S</span>
      <span class="sliger-brand__name">sliger<span>.</span></span>
    </a>
  </div>
</header>

{% schema %}
{
  "name": "SLIGER header",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "url",
      "id": "buy_link",
      "label": "Featured buy link"
    }
  ],
  "presets": [
    {
      "name": "SLIGER header"
    }
  ]
}
{% endschema %}
